{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.shared.schema.json",
  "config": {
    "configVersion": "2.0.0",
    "id": "zip",
    "version": "1.7.4",
    "additionalData": {
      "description": "",
      "author": "",
      "license": "",
      "url": "https://github.com/bsq-ports/quest-zip"
    },
    "workspace": {
